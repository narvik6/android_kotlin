<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Северная часть стрелки (красная, тонкая) -->
    <item>
        <rotate
            android:fromDegrees="0"
            android:toDegrees="0"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <size
                    android:width="4dp"
                    android:height="120dp" />
                <gradient
                    android:startColor="#F44336"
                    android:endColor="#FF7043"
                    android:angle="0" />
            </shape>
        </rotate>
    </item>

    <!-- Южная часть стрелки (серая, тонкая) -->
    <item>
        <rotate
            android:fromDegrees="180"
            android:toDegrees="180"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <size
                    android:width="4dp"
                    android:height="120dp" />
                <gradient
                    android:startColor="#666666"
                    android:endColor="#999999"
                    android:angle="0" />
            </shape>
        </rotate>
    </item>

    <!-- Центральный круг (маленький) -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="16dp"
                android:height="16dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Внутренний круг -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="8dp"
                android:height="8dp" />
            <solid android:color="#333333" />
        </shape>
    </item>
</layer-list>